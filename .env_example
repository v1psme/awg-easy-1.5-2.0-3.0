# =========================
# 0) Container settings
# =========================
# CONTAINER_SUFFIX= # суффикс для запуска нескольких контейнеров (напр. -2, -second)

# =========================
# 1) Bootstrap only (required)
# =========================
WG_HOST= # your extrenal ip
PORT=13544 # web port
# PASSWORD= # your web password. Impotant: use still pass hash PASSWORD_HASH=''
PASSWORD_HASH=''
# ADMIN_LOGIN= # username for web login (empty = password-only)
# WEB_PATH= # web UI path prefix (empty = serve at /, e.g. 'mypanel' -> http://host:port/mypanel/)
# REDIRECT_ROOT=true # redirect / to WEB_PATH (set false to disable)
WG_PORT=7443 #wg port
WG_MTU=1280 #MTU
WG_DEFAULT_ADDRESS=10.28.0.x #default ip wg
# WEBUI_HOST=0.0.0.0
WG_PATH=/etc/amnezia/amneziawg/
WG_DEVICE=eth0
WG_DEFAULT_DNS=1.1.1.1
AMNEZIA_VERSION=2 # 1.5 or 2 (3 in future)

# =========================
# 2) Bootstrap only (optional)
# =========================
# LANG=ru
# MAX_AGE=0

# =========================
# 3) HTTPS bootstrap (optional)
# These must exist before the web server starts
# =========================
# SSL_ENABLED=true
# SSL_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# =========================
# 4) WireGuard hooks / host networking (optional)
# These are system/bootstrap-level and should stay in env
# =========================
# WG_PRE_UP=
# WG_POST_UP=
# WG_PRE_DOWN=
# WG_POST_DOWN=
# WG_UPLINK_CONFIGS_PATH=/etc/wireguard/uplinks

# =========================
# 5) Prometheus/Zabbix profile (optional)
# Still env-based
# =========================
# ENABLE_PROMETHEUS_METRICS=false
# PROMETHEUS_METRICS_PASSWORD=
# PROMETHEUS_METRICS_PASSWORD_HASH=

# =========================
# 6) AmneziaWG obfuscation profile (optional)
# Still env-based bootstrap defaults
# =========================
# JC=
# JMIN=50
# JMAX=1000
# S1=
# S2=
# H1=
# H2=
# H3=
# H4=
# S3=
# S4=

# Мимикрия CPS I1-I5 (v2/v3). Профиль задаётся одной переменной:
# MIMICRY_PROFILE=dns|tls|quic|sip   # default: dns
# MIMICRY_BROWSER=chrome|firefox|safari  # браузерный отпечаток для tls/quic; default: chrome
# MIMICRY_DOMAIN=  # явный фронт-домен (default: случайный из пула региона)
# MIMICRY_REGION=world|ru  # пул доменов; default: world (ru добавляет ya.ru/vk.com/mail.ru/...)
# MIMICRY_ONLY_I1=true  # генерировать только I1 (default: все I1-I5)
#
# Смена MIMICRY_* применяется при рестарте (миграция в WireGuard.js). I1-I5 — декои:
# принимающая сторона их НЕ валидирует, существующие клиенты продолжают работать;
# переэкспорт конфигов нужен только чтобы применить новый профиль клиентам.
# Must-match: только S1-S4, H1-H4, HeaderProtectionKey.
#
# Явные I1..I5 в env всегда побеждают профиль (''/'0'/'null' = отключено):
# I1=
# I2=
# I3=
# I4=
# I5=
# I_DNS_MIMIC_ALL=false  # alias dns-профиля: I2-I5 тоже в DNS-формате (работает только для dns)
# I1_DNS_SITES=icloud.com,google.com,nvidia.com  # пул доменов для dns-профиля
# I_R_MIN=2    # мин. значение <r> для DNS-пакетов (на 10.08.2026: >40 ломает handshake)
# I_R_MAX=40   # макс. значение <r> для DNS-пакетов

# =========================
# 7) AWG 3.0 parameters (only when AMNEZIA_VERSION=3)
# =========================
# HEADER_PROTECTION_KEY_ENABLE=false  # true (default для v3) = включить header protection; false = выключить
# HEADER_PROTECTION_KEY= # 44-char base64 пин ключа; если не задан — генерируется ОДИН раз при первом старте и сохраняется в БД.
#                        # Смена значения = ротация ключа (ВСЕ клиенты должны переимпортировать конфиги)
# CONTENT_PADDING_ADDITION=16-128 # lo-hi range, (off) to disable
# REKEY_AFTER_TIME=100-145
# REKEY_TIMEOUT=4-10
# REJECT_AFTER_TIME=180-200
# KEEPALIVE_TIMEOUT=8-22
# MAX_HANDSHAKE_ATTEMPTS=12-28

# =========================
# Everything else is configured in web setup/settings:
# - admin password
# - WG_HOST
# - client DNS
# - WG_PORT / WG_CONFIG_PORT / WG_MTU
# - WG_DEFAULT_ADDRESS / WG_ALLOWED_IPS / keepalive
# - UI flags / avatars / one-time links / expires
# - Telegram bot
# - traffic history
# - uplinks / DNS routing / ACL / categories
# =========================
